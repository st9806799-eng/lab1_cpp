#include <iostream>
#include <cmath>

using namespace std;

int main() {
    const double PI = 3.14159265358979323846;
    double a = 2.0;
    double b = 13.13;

    double y = cbrt((1.0 - exp(a)) / b) * cos((b / a) * PI) + log(0.708) * b;

    cout << "a = " << a << ", b = " << b << endl;
    cout << "y = " << y << endl;

    return 0;
}
